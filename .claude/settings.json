{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "mcp__workiq__ask_work_iq",
      "mcp__workiq__accept_eula",
      "mcp__ide__getDiagnostics",
      "mcp__ide__executeCode",
      "Skill",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_select_option",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_drag",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_tabs",
      "mcp__playwright__browser_navigate_back",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_handle_dialog",
      "mcp__playwright__browser_file_upload",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_install",
      "mcp__playwright__browser_run_code"
    ],
    "deny": [
      "Read(*.env)",
      "Read(.env*)",
      "Write(C:\\Windows\\*)",
      "Write(C:\\System32\\*)",
      "Write(C:\\SysWOW64\\*)",
      "Write(C:\\Program Files\\*)",
      "Write(C:\\ProgramData\\*)",
      "Write(C:\\bootmgr*)",
      "Write(C:\\boot\\*)",
      "Write(*.sys)",
      "Write(*.dll)",
      "Write(*.exe)",
      "Write(C:\\Users\\All Users\\*)",
      "Write(C:\\Windows.old\\*)",
      "Write(C:\\Program Files (x86)\\*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ~/.claude/hooks/peon-ping/peon.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ~/.claude/hooks/peon-ping/peon.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ~/.claude/hooks/peon-ping/peon.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ~/.claude/hooks/peon-ping/peon.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ~/.claude/hooks/peon-ping/peon.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ~/.claude/hooks/peon-ping/peon.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ~/.claude/hooks/peon-ping/peon.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ~/.claude/hooks/peon-ping/peon.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ~/.claude/hooks/peon-ping/scripts/hook-handle-use.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir // .cwd'); git_info=\"\"; if git -C \"$cwd\" rev-parse --git-dir > /dev/null 2>&1; then branch=$(git -C \"$cwd\" rev-parse --abbrev-ref HEAD 2>/dev/null); if [ -n \"$(git -C \"$cwd\" --no-optional-locks status --porcelain 2>/dev/null)\" ]; then git_info=\" [$branch +]\"; else git_info=\" [$branch]\"; fi; fi; printf \"%s%s\" \"$(basename \"$cwd\")\" \"$git_info\""
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": false,
    "playwright@claude-plugins-official": false
  },
  "forceLoginMethod": "console",
  "skipDangerousModePermissionPrompt": true,
  "webFetch": {
    "autoApprove": true,
    "enabled": true
  },
  "webSearch": {
    "autoApprove": true,
    "enabled": true
  },
  "workspaceAccess": {
    "autoApprove": true
  },
  "effortLevel": "high"
}
