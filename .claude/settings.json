{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "mcp__workiq__ask_work_iq",
      "mcp__workiq__accept_eula",
      "mcp__ide__getDiagnostics",
      "mcp__ide__executeCode",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "Skill"
    ],
    "deny": [
      "Read(*.env)",
      "Read(.env*)",
      "Write(C:\\Windows\\*)",
      "Write(C:\\System32\\*)",
      "Write(C:\\SysWOW64\\*)",
      "Write(C:\\Program Files\\*)",
      "Write(C:\\Program Files \\(x86\\)\\*)",
      "Write(C:\\ProgramData\\*)",
      "Write(C:\\bootmgr*)",
      "Write(C:\\boot\\*)",
      "Write(*.sys)",
      "Write(*.dll)",
      "Write(*.exe)",
      "Write(C:\\Users\\All Users\\*)",
      "Write(C:\\Windows.old\\*)",
      "Write(C:\\Program Files (x86)\\*)"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir // .cwd'); git_info=\"\"; if git -C \"$cwd\" rev-parse --git-dir > /dev/null 2>&1; then branch=$(git -C \"$cwd\" rev-parse --abbrev-ref HEAD 2>/dev/null); if [ -n \"$(git -C \"$cwd\" --no-optional-locks status --porcelain 2>/dev/null)\" ]; then git_info=\" [$branch +]\"; else git_info=\" [$branch]\"; fi; fi; printf \"%s%s\" \"$(basename \"$cwd\")\" \"$git_info\""
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": false,
    "superpowers@superpowers-marketplace": false
  },
  "forceLoginMethod": "console",
  "skipDangerousModePermissionPrompt": true,
  "webFetch": {
    "autoApprove": true,
    "enabled": true
  },
  "webSearch": {
    "autoApprove": true,
    "enabled": true
  },
  "workspaceAccess": {
    "autoApprove": true
  },
